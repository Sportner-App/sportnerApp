EXPO_PUBLIC_API_URL=https://api-production-9004e.up.railway.app
EXPO_PUBLIC_APP_LINK_BASE_URL=https://api-production-9004e.up.railway.app
EXPO_PUBLIC_API_TIMEOUT=10000
EXPO_PUBLIC_ENV=development

# Auth: POST /api/auth/login | /api/auth/register
# Demo (seed): ahmet / elif / mert / zeynep — şifre Demo123!
# Register body: { username, password, firstName, lastName? }

# Adres arama artık sunucudan geçiyor (GET /api/locations/*), sağlayıcı
# anahtarı API tarafında duruyor. Uygulamanın Google anahtarı yok.

# Mapbox — harita render'ı (home haritası, konum seçici, etkinlik detayı)
# Public token (pk.*). Studio > Access tokens.
EXPO_PUBLIC_MAPBOX_TOKEN=
# Boş bırakılırsa constants/map.ts'teki varsayılan Sportner stili kullanılır.
EXPO_PUBLIC_MAPBOX_STYLE_URL=
