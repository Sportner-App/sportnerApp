EXPO_PUBLIC_API_URL=https://sportner-api.onrender.com
EXPO_PUBLIC_API_TIMEOUT=10000
EXPO_PUBLIC_ENV=development

# true: login zorunlu değil (UI geliştirme)
# false: gerçek auth gate + username/password
EXPO_PUBLIC_AUTH_BYPASS=false

# Auth: POST /api/auth/login | /api/auth/register
# Demo (seed): ahmet / elif / mert / zeynep — şifre Demo123!
# Register body: { username, password, firstName, lastName? }

# Google Maps + Places (Autocomplete, Place Details, Geocoding, native map)
# Boş bırakılırsa konum araması Nominatim fallback kullanır.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
